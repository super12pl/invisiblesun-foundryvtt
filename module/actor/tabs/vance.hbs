<section class="tab vance {{tab.cssClass}}" data-group="primary" data-tab="vance">
    <div class="flexcolcenter" style="width: 100%; row-gap:10px;margin-top:15px">
        <h3>Vance Diagram</h3>
        <span>(Right-click to remove block)</span>
        <div class="vance-diagram" style="{{diagramSize system.stats.degree.value}}">
        </div>
        {{#each placedVanceSpells as |item id|}}
        <div class="vance-spell flexrowcenter"
            style="position:absolute;{{spellSize item.system.class item.system.halfSize}};left:{{item.system.left}};top:{{item.system.top}};background-color:{{item.system.color}}"
            data-item-id='{{item._id}}'>
            {{item.name}}</div>
        {{/each}}
    </div>
    <div class="items flexcol">
        <h3>Vance Spells</h3>
        <ol class='items-list'>
            <li class='item flexrow items-header'>
                <div class='item-name'>Name</div>
                <div class="item-resource">Level</div>
                <div class="item-resource">Class</div>
                <div class="item-resource">Depletion</div>
                <div class='item-controls'>
                    <a class='item-control item-create' data-type='vanceSpell'>
                        <i class='fas fa-plus'></i>
                    </a>
                </div>
            </li>
            {{#each vanceSpells as |item id|}}
            <li class='item flexrow' data-item-id='{{item._id}}'>
                <div class='item-name rollable' data-type='ability' data-item-id='{{item._id}}'
                    data-level="{{item.system.level}}">
                    <div class='item-image'>
                        <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' />
                    </div>
                    <h4>{{item.name}}</h4>
                </div>
                <div class="item-name">
                    <h4>{{item.system.level}}</h4>
                </div>
                <div class="item-name">
                    <h4>{{capitalize item.system.class}}</h4>
                </div>
                <div class="item-name">
                    <a class="rollable item-control" data-item-id='{{item._id}}' data-depletion="true"
                        title="Roll for depletion">
                        <h4>{{item.system.depletion}}</h4>
                    </a>
                </div>
                <div class='item-controls'>
                    <a class='item-control item-edit' title="Edit item">
                        <i class='fas fa-edit'></i>
                    </a>
                    <a class='item-control item-delete' title="Delete item permanently">
                        <i class='fas fa-trash'></i>
                    </a>
                    <a class="item-control item-chat" title="Post item to chat">
                        <i class="fas fa-comment-alt"></i>
                    </a>
                    <a class="item-control rollable" title="Roll item" data-item-id='{{item._id}}' data-type="ability"
                        data-level="{{item.system.level}}">
                        <i class="fas fa-dice"></i>
                    </a>
                    <a class="item-control item-vance-place" title="Place on diagram" data-item-id="{{item._id}}">
                        <i class="fas fa-hand"></i>
                    </a>
                </div>
            </li>
            {{/each}}
        </ol>
    </div>

</section>