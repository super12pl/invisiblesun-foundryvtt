<section class="tab advancement {{tab.cssClass}}" data-group="primary" data-tab="advancement">
    <div class="grid grid-3col">
        <div class="flexcolcenter" style="row-gap: 15px;">
            <h3>Progression</h3>
            <div class="flexrowcenter" style="column-gap: 15px;">
                <label>Acumen <input style="width: 40px;" name="system.stats.acumen.value"
                        value="{{system.stats.acumen.value}}" type="number" /></label>

            </div>
            <div class="flexrowcenter" style="column-gap: 15px;">
                <label>Joy <input style="width: 40px;" name="system.stats.joy" value="{{system.stats.joy}}"
                        type="number" /></label>
                <label>Despair <input style="width: 40px;" name="system.stats.despair" value="{{system.stats.despair}}"
                        type="number" /></label>

            </div>
            <div class="flexrowcenter" style="column-gap: 15px;">
                <label>Spent Crux <input style="width: 40px;" name="system.stats.spentCrux.value"
                        value="{{system.stats.spentCrux.value}}" type="number" /></label>
                <label>Total Crux: <input style="width: 40px;" disabled value="{{totalCrux}}" type="number" /></label>
            </div>

        </div>
        <div class="flexcolcenter" style="grid-column-start:2;grid-column-end:4">
            <h3>Testament of Suns Effect</h3>
            <div class="grid grid-2col">
                <div class="flexcolcenter testamentEffects">
                    <span style="{{#if (greq totalCrux 47)}} background-color: indigo;color:white {{/if}}">Level
                        10</span>
                    <span style="{{#if (greq totalCrux 35)}} background-color: indigo;color:white {{/if}}">Level
                        9</span>
                    <span style="{{#if (greq totalCrux 25)}} background-color: indigo;color:white {{/if}}">Level
                        8</span>
                    <span style="{{#if (greq totalCrux 17)}} background-color: indigo;color:white {{/if}}">Level
                        6</span>

                    <span style="{{#if (greq totalCrux 13)}} background-color: indigo;color:white {{/if}}">Level
                        4</span>

                    <span style="{{#if (greq totalCrux 9)}} background-color: indigo;color:white {{/if}}">Level
                        3</span>
                    <span style="{{#if (greq totalCrux 5)}} background-color: indigo;color:white {{/if}}">Level
                        2</span>
                    <span style="background-color: indigo;color:white">No Power</span>
                </div>
                <img height="480" src="systems/invisiblesun/icons/testamentOfSuns.png">
            </div>
        </div>

    </div>
</section>